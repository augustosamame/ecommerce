<div class="page-header">
  <%= link_to backoffice_pricelists_path, class: 'btn btn-default' do %>
    <span class="glyphicon glyphicon-list-alt"></span>
    Back
  <% end %>
  <%= link_to edit_backoffice_pricelist_path(@pricelist), class: 'btn btn-primary' do %>
    <span class="glyphicon glyphicon-pencil"></span>
    Edit
  <% end %>
  <h1>Show Pricelist</h1>
</div>

<dl class="dl-horizontal">
  <dt>Pricelist Name:</dt>
  <dd><%= @pricelist.name %></dd>

  <dt>Status:</dt>
  <dd><%= @pricelist.status %></dd>
</dl>

<h2>Products on this Price List</h2>
<p class="text-muted">
  Only products added here get a custom price on this list — everything else sells at the default store price.
  All amounts are entered as <strong>decimal prices</strong> (soles <code>12.1668</code>, dollars <code>8.90</code>) — never cents.
</p>
<p class="text-muted">
  <strong>Precio S/ (soles)</strong> is what B2B invoicing uses: a static amount, never converted with the exchange
  rate, with up to 4 decimals. The USD columns are optional and only used by the web store for logged-in customers
  assigned to this list.
</p>

<div class="well" style="max-width: 900px;">
  <%= form_tag add_product_backoffice_pricelist_path(@pricelist), method: :post, class: "form-inline" do %>
    <div class="form-group" style="min-width: 320px; margin-right: 10px;">
      <%# bilingual_label makes the select2 filter match Spanish AND English
          regardless of the session locale (labels were permalink-only). %>
      <%= select_tag :product_id,
            options_from_collection_for_select(@addable_products, :id, :bilingual_label),
            include_blank: "— Choose a product —", id: "add-product-select", style: "width: 100%;" %>
    </div>
    <div class="form-group" style="margin-right: 10px;">
      <%= number_field_tag :pen_price, nil, class: "form-control", placeholder: "Precio S/ (ej. 12.1668)", step: "0.0001", min: 0, required: true, style: "width: 190px;" %>
    </div>
    <div class="form-group" style="margin-right: 10px;">
      <%= number_field_tag :usd_price, nil, class: "form-control", placeholder: "USD $ (opcional, ej. 8.90)", step: "0.01", min: 0, style: "width: 190px;" %>
    </div>
    <%= submit_tag "Add Product", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered table-hover">
    <thead>
      <tr>
        <th>Product</th>
        <th>Category</th>
        <th>Default Price (USD)</th>
        <th>Precio S/ (B2B)</th>
        <th>Price (USD $)</th>
        <th>Discounted (USD $)</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @product_prices.each do |pp| %>
        <%# Each row is its own update form: an explicit Save beats the old
            click-to-edit cells, which gave no visible edit affordance. %>
        <tr>
          <%= form_tag update_product_backoffice_pricelist_path(@pricelist, product_price_id: pp.id), method: :patch, id: "pp-form-#{pp.id}" do %>
          <% end %>
          <td><%= pp.product.name %></td>
          <td><%= pp.product.category_list.to_s %></td>
          <td>$ <%= sprintf("%.2f", pp.product.price_cents / 100.0) %></td>
          <td style="width: 150px">
            <%= number_field_tag :pen_price, pp.pen_price, form: "pp-form-#{pp.id}",
                  class: "form-control input-sm", step: "0.0001", min: 0 %>
          </td>
          <td style="width: 130px">
            <%= number_field_tag :usd_price, sprintf("%.2f", pp.price_cents / 100.0), form: "pp-form-#{pp.id}",
                  class: "form-control input-sm", step: "0.01", min: 0 %>
          </td>
          <td style="width: 130px">
            <%= number_field_tag :usd_discounted_price, sprintf("%.2f", pp.discounted_price_cents / 100.0), form: "pp-form-#{pp.id}",
                  class: "form-control input-sm", step: "0.01", min: 0 %>
          </td>
          <td style="white-space: nowrap;">
            <%= submit_tag "Save", form: "pp-form-#{pp.id}", class: "btn btn-primary btn-sm", data: { disable_with: false } %>
            <%= link_to "<i class='material-icons'>delete</i>".html_safe,
                  remove_product_backoffice_pricelist_path(@pricelist, product_price_id: pp.id),
                  method: :delete,
                  class: "btn btn-default btn-sm",
                  data: { confirm: "Remove #{pp.product.name} from this pricelist? It will sell at the default price." } %>
          </td>
        </tr>
      <% end %>
      <% if @product_prices.empty? %>
        <tr><td colspan="7" class="text-muted">No products on this price list yet — every product sells at the default store price. Add the ones that need a custom price above.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# One update form per row, kept outside the table so the markup is valid;
    the row inputs bind to these by id via their form="" attribute. %>
<% @product_prices.each do |pp| %>
  <%= form_tag update_product_backoffice_pricelist_path(@pricelist, product_price_id: pp.id),
        method: :patch, id: "pp-form-#{pp.id}", style: "display:none;" do %>
  <% end %>
<% end %>

<script>
  $(document).ready(function () {
    $("#add-product-select").select2({ width: '320px' });
  });
</script>
