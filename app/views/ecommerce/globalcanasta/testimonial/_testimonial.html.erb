<article class="gc-testimonial product">
  <div class="gc-testimonial__media">
    <video class="gc-testimonial__video" controls preload="none" poster="<%= item.thumbnail.try(:medium_400).try(:url) || item.thumbnail.url %>">
      <source src="<%= item.video.url %>" type="video/mp4">
    </video>
  </div>
  <div class="gc-testimonial__body">
    <p class="gc-testimonial__quote">“<%= item.product_name %>”</p>
    <p class="gc-testimonial__who"><%= item.user_fullname %> · <%= item.user_title %></p>
  </div>
</article>
