<% engine = Ecommerce::Engine.routes.url_helpers %>
<%= render "ecommerce/globalcanasta/store/category_tiles",
      eyebrow: t('ecommerce.globalcanasta.store.header.categories'),
      title: (@category.try(:name).presence || t('ecommerce.globalcanasta.store.header.all_products')),
      tiles: @child_categories.map { |c| { name: gc_category_name(c), image: c.image.medium_400.url, url: engine.products_path(category_id: c.id) } } %>
