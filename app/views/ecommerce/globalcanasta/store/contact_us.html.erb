<%# Contact page: intro + WhatsApp card on the left, message form on the right. %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<main class="gc-static gc-container" id="main-content">
  <div class="gc-static__grid">
    <div class="gc-prose">
      <div class="gc-eyebrow"><%= gc_brand_name %></div>
      <h1><%= t('.send_us_a_message') %></h1>
      <div class="gc-card gc-card__body gc-static__aside">
        <p class="gc-small gc-muted" style="margin:0 0 10px;"><%= gc_t('.whatsapp_hint', 'Faster on WhatsApp — we answer between 9 am and 7 pm.') %></p>
        <a href="<%= gc_whatsapp_url %>" target="_blank" rel="noopener" class="gc-btn gc-btn--whatsapp"><%= gc_icon :whatsapp, size: 18 %> 989 080 023</a>
      </div>
    </div>
    <div class="gc-card gc-card__body gc-form gc-static__form">
      <%= simple_form_for @contact_message, url: engine.contact_us_path, method: :post, html: { class: "gc-form", id: "new_contact" } do |f| %>
        <div class="gc-form__row">
          <%= f.input :name, label: "#{t('.name')} *", input_html: { class: 'gc-input required' } %>
          <%= f.input :email, label: "#{t('.email')} *", input_html: { class: 'gc-input required' } %>
        </div>
        <%= f.input :phone, label: t('.phone'), input_html: { class: 'gc-input' } %>
        <%= f.input :message, label: "#{t('.message')} *", as: :text, input_html: { class: 'gc-input required', rows: 6 } %>
        <%= f.button :submit, t('.send_message'), class: "gc-btn gc-btn--primary gc-btn--lg", id: "contact-form" %>
      <% end %>
    </div>
  </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", function(event) {
  var form = document.getElementById('new_contact');
  if (!form) return;
  form.addEventListener('submit', function(event) {
    if (typeof ga !== 'function') return; // no analytics: plain submit
    event.preventDefault();
    var formSubmitted = false;
    function submitForm() { if (!formSubmitted) { formSubmitted = true; form.submit(); } }
    setTimeout(submitForm, 1000);
    ga('send', 'event', 'Contact Form', 'submit', { hitCallback: submitForm });
  });
});
</script>
