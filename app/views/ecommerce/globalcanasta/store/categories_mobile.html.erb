<% engine = Ecommerce::Engine.routes.url_helpers %>
<%= render "ecommerce/globalcanasta/store/category_tiles",
      title: t('ecommerce.globalcanasta.store.header.categories'),
      tiles: @primary_menu_categories.map { |c| { name: c.image_popular_homepage_overlay_text.presence || gc_category_name(c), image: c.image_popular_homepage.homepage.url, url: engine.sub_categories_m_path(parent_category: c.id) } } %>
