<%# Referral programme: share link + referred users table. %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<main class="gc-commerce gc-account gc-container" id="main-content">
  <header class="gc-commerce__head">
    <div>
      <div class="gc-eyebrow"><%= t('ecommerce.globalcanasta.store.header.my_referral_program') %></div>
      <h1 class="gc-commerce__title"><%= t('.title') %></h1>
    </div>
  </header>

  <div class="gc-referral">
    <div class="gc-referral__copy">
      <div class="gc-eyebrow gc-referral__eyebrow"><%= t('.my_referral_link') %></div>
      <div class="gc-referral__link-row">
        <%= link_to current_user.referral_link, current_user.referral_link, id: 'referral-link', class: "gc-referral__link gc-mono" %>
        <button type="button" id="markup-copy" class="gc-btn gc-btn--accent" data-clipboard-target="#referral-link" title="<%= t('.copy') %>"><%= gc_icon :file, size: 16 %> <%= t('.copy') %></button>
      </div>
      <p class="gc-referral__text"><%= t('.my_referral_instructions_1', brand: gc_brand_name) %></p>
      <p class="gc-referral__text"><%= t('.my_referral_instructions_2') %></p>
      <div class="gc-referral__code"><%= t('ecommerce.globalcanasta.store.header.my_referral_code') %> <strong class="gc-mono"><%= current_user.try(:referral_code) %></strong></div>
    </div>
  </div>

  <% if @referrals.blank? %>
    <div class="gc-empty">
      <div class="gc-empty__icon"><%= gc_icon :gift, size: 32 %></div>
      <h2 class="gc-h3"><%= t('.empty_title') %></h2>
    </div>
  <% else %>
    <div class="gc-card gc-table--wrap">
      <table class="gc-table gc-table--orders">
        <thead>
          <tr>
            <th><%= t('.date') %></th>
            <th><%= t('.name') %></th>
            <th><%= t('.points') %></th>
          </tr>
        </thead>
        <tbody>
          <% @referrals.each do |referred_user| %>
            <tr>
              <td data-label="<%= t('.date') %>"><%= referred_user.created_at.localtime.strftime("%d %b %Y") %></td>
              <td data-label="<%= t('.name') %>"><%= "#{referred_user.first_name} #{referred_user.last_name}" %></td>
              <td data-label="<%= t('.points') %>" class="gc-num"><strong><%= PointsTransaction.find_by(tx_type: 'referral', referred_user_id: referred_user.id).try(:points) || 0 %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</main>

<script>
  $(document).ready(function(){
    var clipboard = new ClipboardJS('#markup-copy');
    clipboard.on('success', function(e) {
      Swal({ type: 'info', title: '<%= j t(".clipboard_message") %>', text: "" });
      e.clearSelection();
    });
  });
</script>
