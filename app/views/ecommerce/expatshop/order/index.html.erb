<%# Order history: one responsive table (cards on mobile via CSS). %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<main class="gc-commerce gc-account gc-container" id="main-content">
  <header class="gc-commerce__head">
    <h1 class="gc-commerce__title"><%= t('.title') %></h1>
  </header>

  <% if @orders.blank? %>
    <div class="gc-empty">
      <div class="gc-empty__icon"><%= gc_icon :box, size: 32 %></div>
      <h2 class="gc-h3"><%= t('.empty_title', default: 'No orders yet') %></h2>
      <a href="<%= engine.products_path %>" class="gc-btn gc-btn--primary"><%= t('ecommerce.expatshop.store.main.hero_cta_primary') %></a>
    </div>
  <% else %>
    <div class="gc-card gc-table--wrap">
      <table class="gc-table gc-table--orders">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= t('.date') %></th>
            <th><%= t('.status') %></th>
            <th><%= t('.total') %></th>
            <th><span class="gc-sr-only"><%= t('.show') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="gc-order-row">
              <td data-label="ID" class="gc-mono gc-order-row__id"><span class="gc-order-row__eyebrow"><%= t('.order', default: 'Order') %></span>#<%= order.id %></td>
              <td data-label="<%= t('.date') %>" class="gc-order-row__date"><%= order.created_at.localtime.strftime("%d %b %Y") %></td>
              <td data-label="<%= t('.status') %>" class="gc-order-row__status"><span class="gc-badge <%= order.payment_status.to_s == 'paid' ? 'gc-badge--stock' : 'gc-badge--origin' %>"><%= friendly_order_status(order) %></span></td>
              <td data-label="<%= t('.total') %>" class="gc-num gc-order-row__total">
                <strong>S/ <%= number_with_precision(order.amount * @exchange_rate, precision: 2, delimiter: ',') %></strong>
                <span class="gc-small gc-faint"><%= number_to_currency(order.amount) %></span>
              </td>
              <td class="gc-table__action gc-order-row__action"><%= link_to t('.my_order'), engine.order_path(order), class: "gc-btn gc-btn--outline gc-btn--sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</main>
