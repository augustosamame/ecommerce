<%# Product card. Rendered on home, listing, search, favourites, related
    products and pre-checkout. Desktop/tablet: image-on-top column card.
    Mobile: the same card stacks one per row (see gc/product-card.scss).
    Hooks kept for the JS responses: form#new_cart_item_<id>, the
    devtech_quantity_field_<id> input, .cart-form, .stock_alert. %>
<% compact = local_assigns[:pre_checkout] %>
<% origin = gc_product_origin(item) %>
<% pct = gc_discount_pct(item) %>
<article class="gc-product-card product <%= compact ? 'gc-product-card--compact pre-checkout-product' : '' %>"
         data-availability="<%= item.in_stock? ? 'in_stock' : 'out_of_stock' %>"
         data-gc-product="<%= item.id %>">
  <div class="gc-product-card__media">
    <%= link_to product_path(item), class: "gc-product-card__img-link", "aria-label": item.name do %>
      <%= image_tag item.image.medium_400.url, class: "gc-product-card__img", alt: item.name, loading: "lazy" %>
    <% end %>
    <div class="gc-product-card__badges">
      <% callout = item.show_callout ? (session[:locale] == 'en-PE' ? item.callout_label_en : item.collout_label_es) : nil %>
      <% callout_discount = item.show_callout ? (session[:locale] == 'en-PE' ? item.callout_discount_label_en : item.callout_discount_label_es) : nil %>
      <%# Backoffice callouts win; the computed −N% only fills in when no discount callout is set %>
      <% if callout_discount.present? %>
        <span class="gc-badge gc-badge--discount"><%= callout_discount %></span>
      <% elsif pct %>
        <span class="gc-badge gc-badge--discount">−<%= pct %>%</span>
      <% end %>
      <% if callout.present? %><span class="gc-badge gc-badge--new"><%= callout %></span><% end %>
      <% unless item.in_stock? %>
        <span class="gc-badge gc-badge--muted"><%= t('.out_of_stock') %></span>
      <% end %>
    </div>
    <% unless compact %>
      <% if current_user %>
        <%= form_tag wishlist_items_path, method: :post, class: "gc-product-card__fav-form" do %>
          <%= hidden_field_tag "wishlist_item[product_id]", item.id, id: nil %>
          <%= hidden_field_tag "wishlist_item[quantity]", 1, id: nil %>
          <button type="submit" class="gc-icon-btn gc-product-card__fav" aria-label="<%= gc_t('.add_to_favourites', 'Add to favourites') %>: <%= item.name %>"><%= gc_icon :heart, size: 15 %></button>
        <% end %>
      <% else %>
        <a href="<%= main_app.new_user_session_path %>" class="gc-icon-btn gc-product-card__fav" aria-label="<%= gc_t('.add_to_favourites', 'Add to favourites') %>: <%= item.name %>"><%= gc_icon :heart, size: 15 %></a>
      <% end %>
    <% end %>
  </div>

  <div class="gc-product-card__body">
    <% if origin.present? %>
      <div class="gc-product-card__origin"><%= origin %></div>
    <% end %>
    <h3 class="gc-product-card__name"><%= link_to item.name, product_path(item) %></h3>
    <% if item.in_stock? %>
      <% if item.short_description.present? %>
        <div class="gc-product-card__size"><%= item.short_description.gsub("**", " · ") %></div>
      <% end %>
    <% else %>
      <div class="gc-product-card__size gc-product-card__size--out"><%= t('.out_of_stock') %></div>
    <% end %>
    <div class="gc-product-card__price-row">
      <% if item.price == item.discounted_price %>
        <span class="gc-price gc-product-card__price"><%= product_session_price(item, "current_price") %></span>
      <% else %>
        <span class="gc-price gc-product-card__price"><%= product_session_price(item, "current_price") %></span>
        <span class="gc-price gc-price--was gc-product-card__was"><%= product_session_price(item, "price") %></span>
      <% end %>
    </div>
  </div>

  <div class="gc-product-card__actions add-to-cart-btn-group">
    <% if item.in_stock? %>
      <%= simple_form_for Ecommerce::CartItem.new, remote: true, html: { class: "cart-form gc-product-card__form", id: "new_cart_item_#{item.id}" } do |f| %>
        <% if compact %>
          <%= f.hidden_field :quantity, value: "1" %>
          <%= f.hidden_field :pre_checkout, value: true %>
        <% else %>
          <div class="gc-stepper" data-gc-max="<%= item.total_quantity %>">
            <button type="button" class="gc-stepper__btn" data-gc-step="-1" aria-label="<%= gc_t('.decrease', 'Decrease quantity') %>">−</button>
            <%= f.input :quantity, label: false, wrapper_html: { class: "gc-stepper__field" }, input_html: { class: 'gc-stepper__value no-spinners', id: "devtech_quantity_field_#{item.id}", value: "1", step: "1", min: "1", inputmode: "numeric", "aria-label": gc_t('.quantity', 'Quantity') } %>
            <button type="button" class="gc-stepper__btn" data-gc-step="1" aria-label="<%= gc_t('.increase', 'Increase quantity') %>">+</button>
          </div>
        <% end %>
        <%= button_tag type: 'submit', class: "gc-btn gc-btn--primary gc-product-card__add index_single_add_to_cart_button" do %>
          <%= t('.add_to_cart') %>
        <% end %>
        <%= f.hidden_field :product_id, value: item.id, id: "product_product_id_#{item.id}" %>
      <% end %>
      <p class="gc-product-card__stock-msg gc-field__error" data-gc-stock-msg hidden><%= t('.no_more_stock_available') %></p>
    <% else %>
      <%= simple_form_for Ecommerce::StockAlert.new, remote: true, html: { class: "stock_alert gc-product-card__form", id: "stock_alert_#{item.id}" } do |f| %>
        <%= f.button :submit, t('.alert_me'), class: "gc-btn gc-btn--outline gc-btn--block index_single_stock_alert_button" %>
        <%= f.hidden_field :product_id, value: item.id, id: "product_product_id_#{item.id}" %>
      <% end %>
    <% end %>
  </div>
</article>
