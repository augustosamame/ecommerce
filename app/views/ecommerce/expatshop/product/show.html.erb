<script type="application/ld+json">
<%= raw product_json_ld(@product).to_json %>
</script>
<script type="application/ld+json">
<%= raw breadcrumb_json_ld(@product).to_json %>
</script>

<div id="fb-root"></div>
<script>(function(d, s, id) {
  var js, fjs = d.getElementsByTagName(s)[0];
  if (d.getElementById(id)) return;
  js = d.createElement(s); js.id = id;
  js.src = 'https://connect.facebook.net/<%= @fb_compatible_locale_code %>/sdk.js#xfbml=1&version=v2.12&appId=<%= Ecommerce.fb_app_id %>&autoLogAppEvents=1';
  fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));</script>

<%# ---------------------------------------------------------------------
    Product detail. Two columns ≥1024 (gallery / details); stacked below.
    On mobile the add-to-cart row is duplicated into a sticky bottom bar
    (#gc-sticky-bar) that submits the same form. Hooks kept for the JS
    responses: form.cart-form, #devtech_quantity_field, .stock_alert.
    --------------------------------------------------------------------- %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<% origin = gc_product_origin(@product) %>
<% pct = gc_discount_pct(@product) %>
<% first_category = @product.translated_category_list.first %>
<% first_category_record = first_category ? Ecommerce::Category.find_by("lower(name) = ?", first_category.downcase) : nil %>
<% rate = (Ecommerce::Control.get_control_value("exchange_rate") || 3.8).to_f %>
<% usd_value = @product.current_price(current_user).to_f %>
<% conversion = session[:currency] == 'usd' ? "≈ S/ #{number_with_precision(usd_value * rate, precision: 2, delimiter: ',')}" : "≈ USD $ #{number_with_precision(usd_value, precision: 2, delimiter: ',')}" %>
<% gallery = ([{ type: 'image', url: @product.image.url, thumb: @product.image.try(:thumb_100).try(:url) || @product.image.url }] +
             @product.media.order(:position, :id).map do |m|
               next nil if m.file.blank?
               if m.image?
                 { type: 'image', url: m.file.url, thumb: m.file.try(:thumb_100).try(:url) || m.file.url }
               else
                 { type: 'video', url: m.file.url, thumb: nil }
               end
             end.compact).reject { |g| g[:url].blank? } %>

<main class="gc-pdp gc-container product-details-main" id="main-content" data-availability="<%= @product.in_stock? ? 'in_stock' : 'out_of_stock' %>">
  <nav aria-label="breadcrumb" class="gc-pdp__crumbs">
    <ol class="gc-breadcrumb">
      <li><%= link_to t('.home'), main_app.root_path %></li>
      <li><%= link_to t('.all_products'), engine.products_path %></li>
      <% if first_category_record %>
        <li><%= link_to first_category, engine.products_path(category_id: first_category_record.id) %></li>
      <% end %>
      <li class="is-current" aria-current="page"><%= @product.name %></li>
    </ol>
  </nav>

  <div class="gc-pdp__grid">
    <%# ---------- Gallery ---------- %>
    <div class="gc-pdp__gallery" id="product-gallery">
      <div class="gc-pdp__main">
        <%= image_tag gallery.first[:url], class: "gc-pdp__main-img", id: "product-gallery-main-img", alt: @product.name %>
        <video src="" controls class="gc-pdp__main-video" id="product-gallery-main-video" style="display:none;"></video>
        <% if pct %><span class="gc-badge gc-badge--discount gc-pdp__main-badge">−<%= pct %>%</span><% end %>
      </div>
      <% if gallery.size > 1 %>
        <div class="gc-pdp__thumbs" role="list">
          <% gallery.each_with_index do |item, idx| %>
            <a href="#" class="gc-pdp__thumb product-gallery-thumb <%= 'is-active' if idx == 0 %>" role="listitem"
               data-type="<%= item[:type] %>" data-url="<%= item[:url] %>" aria-label="<%= t('.view_media', default: 'View media') %> <%= idx + 1 %>">
              <% if item[:type] == 'image' %>
                <%= image_tag item[:thumb] || item[:url], alt: "" %>
              <% else %>
                <span class="gc-pdp__thumb-video"><%= gc_icon :play, size: 18 %></span>
              <% end %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ---------- Details ---------- %>
    <div class="gc-pdp__details">
      <div class="gc-pdp__badges">
        <% if origin.present? %><span class="gc-badge gc-badge--origin"><%= origin %></span><% end %>
        <% if @product.in_stock? %>
          <span class="gc-badge gc-badge--stock"><%= @product.total_quantity.to_i > 0 && @product.total_quantity.to_i < 50 ? "#{@product.total_quantity} #{t('.in_stock').downcase}" : t('.in_stock') %></span>
        <% else %>
          <span class="gc-badge gc-badge--muted"><%= t('.out_of_stock') %></span>
        <% end %>
      </div>

      <h1 class="gc-pdp__title"><%= @product.name %></h1>

      <% if @product.description.present? %>
        <div class="gc-pdp__desc"><%= @product.description.gsub("**", "<br>").html_safe %></div>
      <% end %>

      <div class="gc-pdp__price">
        <span class="gc-price gc-pdp__price-now" id="gc-pdp-price"><%= product_session_price(@product, "current_price") %></span>
        <% if @product.price != @product.discounted_price %>
          <span class="gc-price gc-price--was gc-pdp__price-was"><%= product_session_price(@product, "price") %></span>
          <% if pct %><span class="gc-badge gc-badge--discount">−<%= pct %>%</span><% end %>
        <% end %>
        <span class="gc-pdp__conversion gc-num"><%= conversion %></span>
      </div>

      <div class="gc-pdp__actions add-to-cart-btn-group">
        <% if @product.in_stock? %>
          <%= simple_form_for @cart_item, remote: true, html: { class: "cart-form gc-pdp__form", id: "gc-pdp-form" } do |f| %>
            <div class="gc-stepper gc-stepper--lg" data-gc-max="<%= @product.total_quantity %>">
              <button type="button" class="gc-stepper__btn" data-gc-step="-1" id="devtech_minus" aria-label="<%= t('.decrease') %>">−</button>
              <%= f.input :quantity, label: false, wrapper_html: { class: "gc-stepper__field" }, input_html: { class: 'gc-stepper__value no-spinners', id: "devtech_quantity_field", value: "1", step: "1", min: "1", inputmode: "numeric", "aria-label": t('.quantity') } %>
              <button type="button" class="gc-stepper__btn" data-gc-step="1" id="devtech_plus" aria-label="<%= t('.increase') %>">+</button>
            </div>
            <%= button_tag type: 'submit', class: "gc-btn gc-btn--primary gc-btn--lg gc-pdp__add single_add_to_cart_button" do %>
              <%= t('.add_to_cart') %>
            <% end %>
            <%= f.hidden_field :product_id, value: @product.id, id: "product_product_id_#{@product.id}" %>
          <% end %>
          <% if current_user %>
            <%= form_tag engine.wishlist_items_path, method: :post, class: "gc-pdp__fav-form" do %>
              <%= hidden_field_tag "wishlist_item[product_id]", @product.id, id: nil %>
              <%= hidden_field_tag "wishlist_item[quantity]", 1, id: nil %>
              <button type="submit" class="gc-btn gc-btn--outline gc-btn--lg gc-pdp__fav" aria-label="<%= t('.add_to_favourites') %>"><%= gc_icon :heart, size: 18 %></button>
            <% end %>
          <% else %>
            <a href="<%= main_app.new_user_session_path %>" class="gc-btn gc-btn--outline gc-btn--lg gc-pdp__fav" aria-label="<%= t('.add_to_favourites') %>"><%= gc_icon :heart, size: 18 %></a>
          <% end %>
        <% else %>
          <%= simple_form_for Ecommerce::StockAlert.new, remote: true, html: { class: "stock_alert gc-pdp__form", id: "stock_alert_#{@product.id}" } do |f| %>
            <%= f.button :submit, t('.alert_me'), class: "gc-btn gc-btn--outline gc-btn--lg gc-btn--block index_single_stock_alert_button" %>
            <%= f.hidden_field :product_id, value: @product.id, id: "product_product_id_#{@product.id}" %>
          <% end %>
        <% end %>
      </div>
      <p class="gc-field__error out_of_stock" id="gc-pdp-stock-msg" data-gc-stock-msg hidden><span id="out_of_stock_text"><%= t('.no_more_stock_available') %></span></p>

      <div class="gc-panel gc-panel--list gc-pdp__info">
        <div><span class="gc-diamond" aria-hidden="true">◆</span><%= t('.dispatch_note') %></div>
        <div><span class="gc-diamond" aria-hidden="true">◆</span><%= t('.points_note') %></div>
        <div><span class="gc-diamond" aria-hidden="true">◆</span><%= t('.invoice_note') %></div>
      </div>

      <% if @product.translated_category_list.any? %>
        <div class="gc-pdp__cats gc-small gc-muted">
          <%= t('.categories') %>
          <% @product.translated_category_list.each do |cl| %>
            <% cat = Ecommerce::Category.find_by("lower(name) = ?", cl.downcase) %>
            <%= link_to cl, engine.products_path(category_id: cat.try(:id)), class: "gc-pdp__cat" %>
          <% end %>
        </div>
      <% end %>

      <!-- Product facts (hidden, for LLM/SEO use) -->
      <div class="product-facts gc-sr-only">
        <% if @product.brand&.name.present? %>
          <p><strong><%= t('.brand', default: 'Brand') %>:</strong> <%= @product.brand.name %></p>
        <% end %>
        <p><strong>SKU:</strong> <%= @product.id %></p>
        <p><strong><%= t('.availability', default: 'Availability') %>:</strong>
          <%= @product.in_stock? ? t('.in_stock', default: 'In Stock') : t('.out_of_stock') %>
        </p>
        <% if @product.weight.present? && @product.weight > 0 %>
          <p><strong><%= t('.weight', default: 'Weight') %>:</strong> <%= friendly_cart_weight(@product.weight) %></p>
        <% end %>
      </div>
    </div>
  </div>

  <%# ---------- Related products ---------- %>
  <% related = @related_products.reject { |p| p.id == @product.id } %>
  <% if related.any? %>
    <section class="gc-section gc-pdp__related" aria-labelledby="gc-related-title">
      <div class="gc-section-header">
        <div>
          <div class="gc-eyebrow"><%= t('.related_eyebrow', default: 'Goes well with') %></div>
          <h2 class="gc-display" id="gc-related-title"><%= t('.related_products') %></h2>
        </div>
        <div class="gc-rail__nav">
          <button type="button" class="gc-icon-btn gc-icon-btn--lg gc-icon-btn--white" data-gc-scroller-prev aria-label="<%= t('.previous', default: 'Previous') %>"><%= gc_icon :chevron_left, size: 18 %></button>
          <button type="button" class="gc-icon-btn gc-icon-btn--lg gc-icon-btn--white" data-gc-scroller-next aria-label="<%= t('.next', default: 'Next') %>"><%= gc_icon :chevron_right, size: 18 %></button>
        </div>
      </div>
      <div class="gc-rail" data-gc-scroller>
        <div class="gc-rail__track related-product-slider" data-gc-scroller-track>
          <%= render partial: "ecommerce/#{Ecommerce.ecommerce_layout}/product/product", collection: related.first(12), as: :item %>
        </div>
      </div>
    </section>
  <% end %>
</main>

<%# ---------- Mobile sticky add-to-cart bar ---------- %>
<% if @product.in_stock? %>
  <div class="gc-sticky-bar" id="gc-sticky-bar">
    <div class="gc-sticky-bar__price">
      <span class="gc-price gc-num"><%= product_session_price(@product, "current_price") %></span>
      <% if @product.price != @product.discounted_price %><span class="gc-price gc-price--was gc-small"><%= product_session_price(@product, "price") %></span><% end %>
    </div>
    <button type="button" class="gc-btn gc-btn--primary gc-sticky-bar__btn" data-gc-submit="#gc-pdp-form"><%= t('.add_to_cart') %></button>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Gallery thumbs → main image / video
    var mainImg = document.getElementById('product-gallery-main-img');
    var mainVideo = document.getElementById('product-gallery-main-video');
    var thumbs = document.querySelectorAll('.product-gallery-thumb');
    thumbs.forEach(function (t) {
      t.addEventListener('click', function (e) {
        e.preventDefault();
        thumbs.forEach(function (x) { x.classList.remove('is-active'); });
        t.classList.add('is-active');
        var type = t.getAttribute('data-type');
        var url = t.getAttribute('data-url');
        if (type === 'video') {
          mainImg.style.display = 'none';
          mainVideo.style.display = 'block';
          mainVideo.src = url;
          mainVideo.play();
        } else {
          mainVideo.pause();
          mainVideo.style.display = 'none';
          mainVideo.src = '';
          mainImg.style.display = '';
          mainImg.src = url;
        }
      });
    });

    // Sticky bar submits the main form (jQuery UJS handles remote: true)
    var sticky = document.querySelector('[data-gc-submit]');
    if (sticky) {
      sticky.addEventListener('click', function () {
        var form = document.querySelector(sticky.getAttribute('data-gc-submit'));
        if (form) $(form).trigger('submit.rails');
      });
    }
  });
</script>
