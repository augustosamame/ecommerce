<%# Header cart control. Re-rendered into #cart-line by cart_items/show.js.erb
    after every add-to-cart, so it must be self-contained: button + count +
    mini-cart drawer. On <768 the drawer is hidden and the button links to the
    cart page. %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<% if @cart && @cart.id %>
  <% totals = @cart.get_totals(@current_user) %>
  <div class="gc-minicart" id="gc-minicart">
    <a href="<%= engine.cart_path(@cart.id) %>" class="gc-minicart__btn gc-btn gc-btn--primary" id="dLabel" aria-label="<%= t('.cart', default: 'Cart') %>, <%= totals[:tot_qty] %> <%= t('.items') %>">
      <span class="gc-minicart__icon"><%= gc_icon :bag, size: 18 %></span>
      <span class="gc-minicart__label"><%= t('.cart', default: 'Cart') %></span>
      <span class="gc-count gc-minicart__count"><%= totals[:tot_qty] %></span>
    </a>

    <div class="gc-minicart__drawer" aria-label="<%= t('.cart', default: 'Cart') %>">
      <% if @cart.cart_items.any? %>
        <ul class="gc-minicart__items">
          <% @cart.cart_items.sort_by { |item| cart_item_locked?(item) ? 1 : 0 }.each do |item| %>
            <li class="gc-minicart__item">
              <img src="<%= item.product.image.thumb_100.url %>" alt="" class="gc-minicart__thumb" loading="lazy">
              <div class="gc-minicart__info">
                <div class="gc-minicart__name"><%= item.product.name %></div>
                <div class="gc-minicart__meta"><%= friendly_cart_weight(item.product.weight) %></div>
                <div class="gc-minicart__price gc-num"><%= session_price(item.product, "current_price") %> <span class="gc-faint">× <%= item.quantity %></span></div>
              </div>
              <% if cart_item_locked?(item) %>
                <span class="gc-minicart__remove is-locked" title="<%= t('combo_discounts.combo_injected_tooltip') %>" aria-label="<%= t('combo_discounts.combo_injected_tooltip') %>"><%= gc_icon :trash, size: 16 %></span>
              <% else %>
                <%= link_to cart_item_path(item.id), method: :delete, remote: true, class: "gc-minicart__remove", "aria-label": "#{t('.remove', default: 'Remove')} #{item.product.name}" do %>
                  <%= gc_icon :trash, size: 16 %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <div class="gc-minicart__subtotal">
          <span class="gc-label"><%= t('.subtotal', default: 'Subtotal') %></span>
          <span class="gc-price gc-num"><%= session_price(totals[:tot_acum]) %></span>
        </div>
        <% if session[:currency] == "usd" %>
          <div class="gc-minicart__conversion gc-small gc-muted gc-num">≈ S/ <%= number_with_precision(totals[:tot_acum] * @exchange_rate, precision: 2) %></div>
        <% end %>
        <div class="gc-minicart__actions">
          <a href="<%= engine.cart_path(@cart.id) %>" class="gc-btn gc-btn--outline gc-btn--block"><%= t('.view_cart') %></a>
          <a href="<%= engine.checkout_path %>" class="gc-btn gc-btn--secondary gc-btn--block"><%= t('.checkout') %></a>
        </div>
      <% else %>
        <div class="gc-minicart__empty">
          <div class="gc-minicart__empty-icon"><%= gc_icon :bag, size: 28 %></div>
          <p class="gc-small gc-muted"><%= t('.empty', default: 'Your cart is empty.') %></p>
          <a href="<%= engine.products_path %>" class="gc-btn gc-btn--primary gc-btn--sm"><%= t('.start_shopping', default: 'Start shopping') %></a>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
