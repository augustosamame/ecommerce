<%# GlobalCanasta storefront header.
    One markup tree, three layouts via CSS:
      ≥1024  two rows (utility row + category row), currency/locale selects
      768–1023 single row + scrollable category strip
      <768   hamburger · logo · favourites · cart, search on its own row.
    Currency and locale live inside the drawer below 1024 (deliberate). %>
<% engine = Ecommerce::Engine.routes.url_helpers %>
<% wishlist_url = current_user ? (session[:wishlist_id] ? engine.wishlist_path(session[:wishlist_id]) : engine.favorites_path) : main_app.new_user_session_path %>

<%= render 'ecommerce/expatshop/store/top_promo' %>

<header class="gc-header" id="gc-header">
  <div class="gc-header__row1" id="gc-header-row1">
    <div class="gc-container gc-container--wide gc-header__bar">
      <button type="button" class="gc-header__menu-btn gc-icon-btn gc-icon-btn--lg" id="gc-menu-open" aria-label="<%= gc_t('.menu', 'Menu') %>" aria-controls="gc-drawer" aria-expanded="false">
        <%= gc_icon :menu, size: 22 %>
      </button>

      <a href="<%= root_path %>" class="gc-header__logo" aria-label="<%= gc_brand_name %>">
        <%= gc_logo(height: 40, css: "gc-header__logo-img") %>
      </a>

      <form action="<%= search_product_path %>" method="get" class="gc-search gc-header__search" role="search">
        <span class="gc-search__icon"><%= gc_icon :search, size: 17 %></span>
        <label for="search" class="gc-sr-only"><%= gc_t('.search', 'Search') %></label>
        <input type="search" name="search" id="search" value="" autocomplete="off" placeholder="<%= t('.search_placeholder') %>">
        <button type="submit" class="gc-search__submit" aria-label="<%= gc_t('.search', 'Search') %>"><%= gc_icon :arrow_right, size: 18 %></button>
      </form>

      <div class="gc-header__selects">
        <label class="gc-sr-only" for="currency"><%= gc_t('.currency', 'Currency') %></label>
        <select id="currency" class="gc-select" aria-label="<%= gc_t('.currency', 'Currency') %>">
          <option value="pen" <%= session[:currency] == 'usd' ? "" : "selected" %>>PEN S/</option>
          <option value="usd" <%= session[:currency] == 'usd' ? "selected" : "" %>>USD $</option>
        </select>
        <label class="gc-sr-only" for="lang"><%= t('.language') %></label>
        <select id="lang" class="gc-select" aria-label="<%= t('.language') %>">
          <option value="spanish" <%= session[:locale] == 'en-PE' ? "" : "selected" %>>ES</option>
          <option value="english" <%= session[:locale] == 'en-PE' ? "selected" : "" %>>EN</option>
        </select>
      </div>

      <nav class="gc-header__actions" aria-label="<%= gc_t('.account_navigation', 'Account') %>">
        <a href="<%= gc_whatsapp_url %>" target="_blank" rel="noopener" class="gc-header__action gc-header__action--wa">
          <span class="gc-header__action-icon gc-header__action-icon--green"><%= gc_icon :whatsapp, size: 18 %></span>
          <span class="gc-header__action-label">WhatsApp</span>
        </a>

        <a href="<%= wishlist_url %>" class="gc-header__action gc-header__action--fav" aria-label="<%= gc_t('.favourites', 'Favourites') %>">
          <span class="gc-header__action-icon"><%= gc_icon :heart, size: 18 %></span>
          <span class="gc-header__action-label"><%= gc_t('.favourites', 'Favourites') %></span>
        </a>

        <% if current_user %>
          <div class="gc-menu gc-header__action gc-header__action--account" id="gc-account-menu">
            <button type="button" class="gc-menu__toggle" aria-haspopup="true" aria-expanded="false" aria-controls="gc-account-list">
              <span class="gc-header__action-icon"><%= gc_icon :user, size: 18 %></span>
              <span class="gc-header__action-label"><%= current_user.try(:first_name).presence || t('.my_account') %></span>
              <%= gc_icon :chevron_down, size: 14, css: "gc-menu__caret" %>
            </button>
            <ul class="gc-menu__list" id="gc-account-list">
              <% if current_user.admin? || current_user.driver? %>
                <li><%= link_to "Backoffice", engine.backoffice_dashboard_path, class: "gc-menu__item gc-menu__item--admin" %></li>
              <% end %>
              <% if current_user.respond_to?(:accountant?) && current_user.accountant? %>
                <li><%= link_to "Facturación", main_app.invoicing_root_path, class: "gc-menu__item gc-menu__item--admin" %></li>
              <% end %>
              <li><%= link_to engine.points_path, class: "gc-menu__item" do %><%= t('.my_points') %> <span class="gc-count"><%= current_user.try(:points) %></span><% end %></li>
              <li><%= link_to t('.my_orders'), engine.orders_path, class: "gc-menu__item" %></li>
              <li><%= link_to t('.my_addresses'), engine.addresses_path, class: "gc-menu__item" %></li>
              <li><%= link_to t('.favorite_products'), engine.favorites_path, class: "gc-menu__item" %></li>
              <li><%= link_to t('.my_account'), main_app.edit_user_registration_path, class: "gc-menu__item" %></li>
              <li>
                <a class="gc-menu__item" href="<%= engine.referral_path %>">
                  <%= t('.my_referral_program') %>
                  <span class="gc-menu__meta gc-mono"><%= t('.my_referral_code') %><%= current_user.try(:referral_code) %></span>
                </a>
              </li>
              <li class="gc-menu__divider"></li>
              <li><%= link_to t('.sign_out'), main_app.logout_path, class: "gc-menu__item" %></li>
            </ul>
          </div>
        <% else %>
          <a href="<%= main_app.new_user_session_path %>" class="gc-header__action gc-header__action--account">
            <span class="gc-header__action-icon"><%= gc_icon :user, size: 18 %></span>
            <span class="gc-header__action-label"><%= t('.my_account') %></span>
          </a>
        <% end %>

        <div id="cart-line" class="gc-header__cart">
          <%= render "ecommerce/#{Ecommerce.ecommerce_layout}/store/cart", cart: @cart %>
        </div>
      </nav>
    </div>
  </div>

  <div class="gc-header__row2">
    <div class="gc-container gc-container--wide">
      <form action="<%= search_product_path %>" method="get" class="gc-search gc-header__search-mobile" role="search">
        <span class="gc-search__icon"><%= gc_icon :search, size: 17 %></span>
        <label for="search-mobile" class="gc-sr-only"><%= gc_t('.search', 'Search') %></label>
        <input type="search" name="search" id="search-mobile" value="" autocomplete="off" placeholder="<%= t('.search_placeholder') %>">
      </form>

      <nav class="gc-catnav" aria-label="<%= gc_t('.categories', 'Categories') %>">
        <ul class="gc-catnav__list">
          <li><a href="<%= engine.products_path %>" class="gc-catnav__link <%= active_all_products_category() == 'active' ? 'is-active' : '' %>"><%= t('.all_products') %></a></li>
          <% @primary_menu_categories.each do |category| %>
            <% if category.id == 47 %>
              <li><%= link_to category.name, engine.products_path(filter: 'new_products'), class: "gc-catnav__link #{match_active_category(category) == 'active' ? 'is-active' : ''} #{category.highlighted? ? 'is-highlighted' : ''}" %></li>
            <% else %>
              <% unless category.id == 30 && !@banana_permission %>
                <li><%= link_to category.name, engine.products_path(category_id: category.id), class: "gc-catnav__link #{match_active_category(category) == 'active' ? 'is-active' : ''} #{category.highlighted? ? 'is-highlighted' : ''}" %></li>
              <% end %>
            <% end %>
          <% end %>
          <li class="gc-catnav__spacer" aria-hidden="true"></li>
          <li><a href="<%= engine.products_path(filter: 'new_products') %>" class="gc-catnav__link gc-catnav__link--new"><%= gc_t('.new_arrivals', 'New arrivals') %></a></li>
          <li><a href="<%= engine.products_path(filter: 'discounted_products') %>" class="gc-catnav__link gc-catnav__link--offers"><%= gc_t('.offers', 'Offers') %></a></li>
          <% if current_user %>
            <li><a href="<%= engine.favorites_path %>" class="gc-catnav__link gc-catnav__link--frequent"><%= t('.favorite_products') %></a></li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</header>

<div id="js_now_flash">
  <% if notice.present? %>
    <%= render partial: "ecommerce/application/js_now_flash" %>
  <% end %>
</div>

<%# ---------- Mobile / tablet drawer ---------- %>
<div class="gc-drawer" id="gc-drawer" aria-hidden="true">
  <div class="gc-drawer__scrim" data-gc-drawer-close></div>
  <aside class="gc-drawer__panel" role="dialog" aria-modal="true" aria-label="<%= gc_t('.menu', 'Menu') %>">
    <div class="gc-drawer__head">
      <%= gc_logo(height: 28) %>
      <button type="button" class="gc-icon-btn gc-icon-btn--lg" data-gc-drawer-close aria-label="<%= gc_t('.close', 'Close') %>"><%= gc_icon :close, size: 20 %></button>
    </div>

    <nav class="gc-drawer__section" aria-label="<%= gc_t('.categories', 'Categories') %>">
      <div class="gc-label gc-drawer__title"><%= gc_t('.categories', 'Categories') %></div>
      <ul class="gc-drawer__list">
        <li><a href="<%= engine.products_path %>" class="gc-drawer__link"><%= t('.all_products') %></a></li>
        <% @primary_menu_categories.each do |category| %>
          <% next if category.id == 30 && !@banana_permission %>
          <% target = category.id == 47 ? engine.products_path(filter: 'new_products') : engine.products_path(category_id: category.id) %>
          <li><%= link_to category.name, target, class: "gc-drawer__link #{category.highlighted? ? 'is-highlighted' : ''}" %></li>
        <% end %>
        <li><a href="<%= engine.products_path(filter: 'new_products') %>" class="gc-drawer__link gc-drawer__link--new"><%= gc_t('.new_arrivals', 'New arrivals') %></a></li>
        <li><a href="<%= engine.products_path(filter: 'discounted_products') %>" class="gc-drawer__link"><%= gc_t('.offers', 'Offers') %></a></li>
      </ul>
    </nav>

    <nav class="gc-drawer__section" aria-label="<%= t('.my_account') %>">
      <div class="gc-label gc-drawer__title"><%= t('.my_account') %></div>
      <ul class="gc-drawer__list">
        <% if current_user %>
          <% if current_user.admin? || current_user.driver? %>
            <li><%= link_to "Backoffice", engine.backoffice_dashboard_path, class: "gc-drawer__link gc-menu__item--admin" %></li>
          <% end %>
          <% if current_user.respond_to?(:accountant?) && current_user.accountant? %>
            <li><%= link_to "Facturación", main_app.invoicing_root_path, class: "gc-drawer__link gc-menu__item--admin" %></li>
          <% end %>
          <li><%= link_to engine.points_path, class: "gc-drawer__link" do %><%= t('.my_points') %> <span class="gc-count"><%= current_user.try(:points) %></span><% end %></li>
          <li><%= link_to t('.my_orders'), engine.orders_path, class: "gc-drawer__link" %></li>
          <li><%= link_to t('.my_addresses'), engine.addresses_path, class: "gc-drawer__link" %></li>
          <li><%= link_to t('.favorite_products'), engine.favorites_path, class: "gc-drawer__link" %></li>
          <li><%= link_to t('.my_account'), main_app.edit_user_registration_path, class: "gc-drawer__link" %></li>
          <li><%= link_to "#{t('.my_referral_program')} · #{t('.my_referral_code')}#{current_user.try(:referral_code)}", engine.referral_path, class: "gc-drawer__link" %></li>
          <li><%= link_to t('.sign_out'), main_app.logout_path, class: "gc-drawer__link" %></li>
        <% else %>
          <li><%= link_to t('.sign_in'), main_app.new_user_session_path, class: "gc-drawer__link" %></li>
          <li><%= link_to gc_t('.create_account', 'Create an account'), main_app.new_user_registration_path(sign_up_type: 'non-guest'), class: "gc-drawer__link" %></li>
        <% end %>
      </ul>
    </nav>

    <div class="gc-drawer__section">
      <div class="gc-label gc-drawer__title"><%= gc_t('.settings', 'Settings') %></div>
      <div class="gc-drawer__setting">
        <span class="gc-drawer__setting-label"><%= gc_t('.currency', 'Currency') %></span>
        <div class="gc-segment" role="group" aria-label="<%= gc_t('.currency', 'Currency') %>">
          <a href="#" id="pen-currency" class="gc-segment__btn <%= session[:currency] == 'usd' ? '' : 'is-active' %>">PEN S/</a>
          <a href="#" id="usd-currency" class="gc-segment__btn <%= session[:currency] == 'usd' ? 'is-active' : '' %>">USD $</a>
        </div>
      </div>
      <div class="gc-drawer__setting">
        <span class="gc-drawer__setting-label"><%= t('.language') %></span>
        <div class="gc-segment" role="group" aria-label="<%= t('.language') %>">
          <a href="#" id="es-lang" class="gc-segment__btn <%= session[:locale] == 'en-PE' ? '' : 'is-active' %>">Español</a>
          <a href="#" id="en-lang" class="gc-segment__btn <%= session[:locale] == 'en-PE' ? 'is-active' : '' %>">English</a>
        </div>
      </div>
    </div>

    <div class="gc-drawer__section gc-drawer__foot">
      <a href="<%= gc_whatsapp_url %>" target="_blank" rel="noopener" class="gc-btn gc-btn--whatsapp gc-btn--block"><%= gc_icon :whatsapp, size: 18 %> WhatsApp</a>
    </div>
  </aside>
</div>

<script>
  function redirectToCart() {
    window.location.href = "<%= @cart && @cart.id ? engine.cart_path(@cart.id) : engine.products_path %>";
  }
</script>
