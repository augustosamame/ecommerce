<%# GlobalCanasta auth shell (Devise + change-password): cream page, small
    logo header, centred card, one-line footer. Used by the host app via
    Ecommerce.ecommerce_devise_layout = "devise_expatshop". %>
<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s.split('-').first %>">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="google" content="notranslate" />
  <meta name="theme-color" content="#F8F5EF"/>
  <%= display_meta_tags site: Ecommerce.site_name %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag 'ecommerce/application', media: 'all' %>
  <%= stylesheet_link_tag "ecommerce/expatshop", media: "all" %>
  <%= javascript_include_tag 'ecommerce/application' %>
  <%= csrf_meta_tags %>
</head>

<body class="gc-auth-body">
  <div class="gc-site gc-auth-shell">
    <header class="gc-auth-shell__head">
      <a href="<%= main_app.root_path %>" aria-label="<%= gc_brand_name %>"><%= gc_logo(height: 36) %></a>
      <a href="<%= main_app.root_path %>" class="gc-btn gc-btn--ghost"><%= gc_icon :chevron_left, size: 16 %> <%= t('ecommerce.expatshop.store.header.home', default: 'Home') %></a>
    </header>

    <main class="gc-auth-shell__main" id="main-content">
      <%= render 'ecommerce/application/flashes' %>
      <%= yield %>
    </main>

    <footer class="gc-auth-shell__foot">
      © <%= Date.current.year %> <%= gc_brand_name %> · <%= Ecommerce.company_legal_name %> · RUC <%= Ecommerce.company_vat %>
    </footer>
  </div>
</body>
</html>
